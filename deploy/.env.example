# Public HTTPS address of the server, without a path. Required.
PUBLIC_URL=https://wiki.example.com

# Folder of notes to serve. It is prepared on the first start; existing notes
# stay where they are. Create it yourself first: Docker would create it as root.
VAULT=./vault

# User and group that own the vault folder (`id -u`, `id -g`).
PUID=1000
PGID=1000

# Port on 127.0.0.1 for your reverse proxy. Not used with the tunnel.
PORT=8787

# Cloudflare Tunnel token, only for `docker compose --profile tunnel up -d`.
TUNNEL_TOKEN=
